NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27017/mern_blog
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters_access
JWT_REFRESH_SECRET=replace_with_at_least_32_random_characters_refresh
JWT_ISSUER=mern-blog-api
JWT_ACCESS_AUDIENCE=mern-blog-web
JWT_REFRESH_AUDIENCE=mern-blog-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=120
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10
REGISTER_RATE_WINDOW_MS=3600000
REGISTER_RATE_MAX=10
OAUTH_RATE_WINDOW_MS=900000
OAUTH_RATE_MAX=20
ADMIN_NAME=Demo Administrator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=DemoAdmin!2026
SEED_USER_EMAIL=user@example.test
SEED_USER_PASSWORD=DemoUser!2026
